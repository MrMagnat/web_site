# ── База данных ────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/andrua_famil"

# ── Аутентификация (NextAuth) ──────────────────────────
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ── Ключ шифрования секретов в БД (64 hex-символа) ─────
# Сгенерировать:  openssl rand -hex 32
# НЕ менять после первой записи секретов (ключи Ozon станут нечитаемыми).
ENCRYPTION_KEY="your-64-char-hex-string-here"

# ── Логин/пароль для админки ──────────────────────────
ADMIN_EMAIL="admin@andruafamil.ru"
ADMIN_PASSWORD="your-secure-password"

# ── Онлайн-касса (заполнить при подключении) ──────────
KASSA_LOGIN=""
KASSA_PASSWORD=""
KASSA_GROUP_ID=""
KASSA_PROVIDER="orangedata"  # orangedata | atol

# ── Ozon Логистика (заполнить при подключении) ─────────
OZON_CLIENT_ID=""
OZON_API_KEY=""

# ── SMTP для писем (Resend) ────────────────────────────
SMTP_FROM="noreply@andruafamil.ru"
RESEND_API_KEY=""

# ── Публичный URL сайта ────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://andruafamil.ru"
NEXT_PUBLIC_DEFAULT_LOCALE="ru"
