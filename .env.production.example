# ─────────────────────────────────────────────────────────────────────
# Скопируйте этот файл в .env.production и заполните реальными значениями:
#     cp .env.production.example .env.production && nano .env.production
# Файл .env.production в git НЕ попадает (см. .gitignore).
# ─────────────────────────────────────────────────────────────────────

# ── Имя проекта Docker (фиксируем, чтобы имена томов были предсказуемы) ──
COMPOSE_PROJECT_NAME=andrua

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_USER=andrua
POSTGRES_PASSWORD=ПРИДУМАЙТЕ_СЛОЖНЫЙ_ПАРОЛЬ
POSTGRES_DB=andrua_famil

# DATABASE_URL внутри Docker всегда указывает на сервис "postgres".
# (compose переопределяет это значение, но оставьте корректным для миграций)
DATABASE_URL=postgresql://andrua:ПРИДУМАЙТЕ_СЛОЖНЫЙ_ПАРОЛЬ@postgres:5432/andrua_famil

# ── КРИТИЧНО: ключ шифрования секретов в БД ─────────────────────────────
# Им зашифрованы ключи Ozon в базе. При переносе на новый сервер
# ИСПОЛЬЗУЙТЕ ТОТ ЖЕ КЛЮЧ, что и на старом — иначе Ozon-ключи не расшифруются.
# Сгенерировать новый (только для чистой установки):
#   openssl rand -hex 32
ENCRYPTION_KEY=64_СИМВОЛЬНАЯ_HEX_СТРОКА

# ── Next-Auth / сессии ──────────────────────────────────────────────────
NEXTAUTH_SECRET=СЛУЧАЙНАЯ_СТРОКА_32+_СИМВОЛА
NEXTAUTH_URL=https://andrua-famil.ru

# ── Доступ в админку ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@andrua-famil.ru
ADMIN_PASSWORD=ПРИДУМАЙТЕ_СЛОЖНЫЙ_ПАРОЛЬ

# ── Публичные переменные сайта ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://andrua-famil.ru
NEXT_PUBLIC_DEFAULT_LOCALE=ru

# ── Email (необязательно — для рассылок/уведомлений) ────────────────────
RESEND_API_KEY=
SMTP_FROM=

# ── Ozon ────────────────────────────────────────────────────────────────
# Ключи Ozon вводятся в админке (Интеграции → Ozon) и хранятся в БД
# в зашифрованном виде. Здесь их указывать НЕ нужно.
